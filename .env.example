# Execute npm run setup depois de npm ci. Nunca publique seu arquivo .env.
SPLINK_PORT=3210
# Diretório absoluto opcional; por padrão usa data/ dentro do projeto.
# SPLINK_DATA_DIR=C:/caminho/splink-dados
# Caminhos opcionais para executáveis, sem aspas de shell ou argumentos.
# SPLINK_PYTHON=C:/caminho/python.exe
# SPLINK_CODEX=C:/caminho/codex.exe
# Também aceita o arquivo codex.js instalado pelo npm.
# Formas aceitas pelo SEU negócio: pix,credito,debito,boleto,link,shopee,mercadolivre
SPLINK_PAYMENT_METHODS=pix
# Reconhecimento local de áudio: tiny, base ou small. Baixe antes de usar.
SPLINK_WHISPER_MODEL=base
# Link HTTPS opcional do catálogo público da sua empresa. Vazio por padrão.
# SPLINK_CATALOG_URL=https://seusite.example/catalogo
